# Copy to .env and export before running the service. Every value has a default,
# so local development works with no file at all.

APP_ENV=local
APP_ADDR=:8080

HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# SMS confirmations. Leave these unset to use the log-only notifier: the message
# is written to the log instead of being sent, so no Twilio account is needed
# for local development or tests. Real values belong in your own environment,
# never in a committed file.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
