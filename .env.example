# Copy to .env and export before running the service. Every value has a default,
# so local development works with no file at all.

APP_ENV=local
APP_ADDR=:8080

HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Optional Twilio settings. Without all three the service uses the log-only
# notifier, which logs the check-in SMS instead of sending it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
