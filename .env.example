# Copy to .env and export before running the service. Every value has a default
# except PAYMENT_HOURLY_RATE, which is required and has to be set before the
# service will start.

APP_ENV=local
APP_ADDR=:8080

HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Payments. PAYMENT_HOURLY_RATE is required: a missing, non-numeric or negative
# value stops the service from starting. The value is an integer in minor units
# (5000 is INR 50.00) and prices every lot created without an hourlyRate of its
# own; a lot rate of 0 means free parking. PAYMENT_PROVIDER selects the payment
# provider and defaults to the fake one, which needs no account and performs no
# network call.
PAYMENT_PROVIDER=fake
PAYMENT_HOURLY_RATE=5000

# Stripe. Both secrets are required when PAYMENT_PROVIDER=stripe and the service
# refuses to start without them. Keep the real values out of the repository:
# never commit them, and leave them empty here. STRIPE_API_BASE_URL is optional
# and points at https://api.stripe.com when it is empty; set it only to target a
# stub or a proxy, it holds no credential.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=

# Twilio confirmation SMS. All three are needed to send for real; leave them
# empty and the service uses the log-only notifier, which is what local
# development and tests do. Never commit real credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
